{
  "name": "family-calendar-oss",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 execute DB --local --file=migrations/0001_init.sql && wrangler d1 execute DB --local --file=migrations/0002_ab_and_links.sql",
    "db:seed:demo": "wrangler d1 execute DB --local --file=seeds/demo.sql",
    "demo:setup": "npm run db:migrate:local && npm run db:seed:demo",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.6.0"
  }
}
